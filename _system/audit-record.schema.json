{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visionary Media — Audit Record v1",
  "description": "The handoff artifact between the AI Visibility workflow and the Proposal workflow. Designed backwards from what the proposal template consumes. Every field here lands in a named proposal section. If a field is absent, the proposal leaves a REPLACE marker — it never invents.",
  "type": "object",
  "required": [
    "schema_version",
    "client",
    "run",
    "platform_metrics",
    "prompt_runs",
    "gaps",
    "recommendations",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "client": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "How THEY describe their category. Drives prompt selection."
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Named by the client or on their own site. Not guessed."
        },
        "positioning_note": {
          "type": "string",
          "description": "Repositioning, rebrand, pivot — anything that means the engines learned an out-of-date story."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "date",
        "operator"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "operator": {
          "type": "string"
        },
        "prompt_set_reviewed_by_human": {
          "type": "boolean",
          "description": "MUST be true before this record is used in a proposal. A cold prompt set produces a generic audit."
        }
      }
    },
    "platform_metrics": {
      "type": "object",
      "description": "→ proposal section: 'Where CLIENT stands today'",
      "properties": {
        "source": {
          "type": "string",
          "examples": [
            "Semrush",
            "Profound"
          ]
        },
        "ai_visibility_score": {
          "type": "number"
        },
        "mentions_by_engine": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "cited_pages_by_engine": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "authority_score": {
          "type": "number"
        },
        "organic_traffic": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "delta_pct": {
              "type": "number"
            }
          }
        },
        "organic_keywords": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "delta_pct": {
              "type": "number"
            }
          }
        },
        "paid_keywords": {
          "type": "number"
        },
        "backlinks": {
          "type": "number"
        },
        "referring_domains": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "When the figures were read."
        },
        "evidence_screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filenames in images/. Screenshots of the platform UI the figures were read from. These are the provenance — they become figures in the report."
        }
      }
    },
    "prompt_runs": {
      "type": "array",
      "description": "→ proposal section: 'What we found'. The evidence table. One object per prompt per engine.",
      "items": {
        "type": "object",
        "required": [
          "prompt",
          "engine",
          "date",
          "client_named",
          "competitors_named"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "engine": {
            "enum": [
              "ChatGPT",
              "Perplexity",
              "Gemini",
              "Google AI Mode",
              "Google AI Overviews",
              "Claude",
              "Copilot"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "prompt_type": {
            "enum": [
              "category",
              "alternatives",
              "comparison",
              "branded",
              "buying_guide"
            ]
          },
          "client_named": {
            "type": "boolean"
          },
          "client_position": {
            "type": [
              "integer",
              "null"
            ]
          },
          "competitors_named": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources_cited": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domains the engine cited. Branded queries answered from review aggregators are a finding in themselves."
          },
          "sentiment": {
            "enum": [
              "positive",
              "neutral",
              "hedged",
              "negative",
              "n/a"
            ]
          },
          "screenshot": {
            "type": "string",
            "description": "Filename in images/. Becomes a figure in the proposal."
          },
          "verbatim_note": {
            "type": "string",
            "description": "Short, factual. Not interpretation."
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "→ audit report section: 'What is missing'. Measured facts only. NO SCORES. A layer appears here when we can state, from evidence, what is absent — not when we can put a number on it.",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "finding",
          "evidence"
        ],
        "properties": {
          "layer": {
            "enum": [
              "crawlability",
              "entity_schema",
              "on_page",
              "off_domain_authority",
              "live_ai_baseline"
            ]
          },
          "finding": {
            "type": "string",
            "description": "What is TRUE, in plain language, from the evidence. One or two sentences. Not a judgement, not a grade."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The measurements this finding rests on. Required — a finding without evidence is an opinion."
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The concrete things that are absent. Each one should be something a deliverable could create."
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "→ proposal section: 'The plan'. Tracks, in priority order.",
      "items": {
        "type": "object",
        "required": [
          "track",
          "rationale",
          "time_to_impact",
          "deliverables"
        ],
        "properties": {
          "track": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "description": "Why this, for THIS client. The interpretation is the product."
          },
          "time_to_impact": {
            "enum": [
              "days",
              "weeks",
              "1-3 months",
              "3-6 months"
            ]
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "client_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "→ proposal section: 'What changes, measured'. Must trace to platform_metrics.",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "today",
          "day_90"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "today": {
            "type": [
              "number",
              "string"
            ]
          },
          "day_90": {
            "type": [
              "number",
              "string"
            ]
          },
          "stretch": {
            "type": [
              "number",
              "string"
            ]
          },
          "pace_note": {
            "type": "string",
            "description": "Why this row moves fast or slow. This is the paragraph competitors can't copy."
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything the workflow could NOT determine. The proposal turns each of these into a REPLACE marker and lists them for the rep. Never silently filled."
    }
  }
}
